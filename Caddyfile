# Ahnoud Tech, static site served by Caddy inside the container.
# Traefik terminates TLS and routes the domain; this server listens on :80.
:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# images are renamed when they change, so cache them hard;
	# scripts and the manifest keep their names, so they revalidate (ETag) after a day
	@immutable path /images/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@static path /support.js /image-slot.js /site.webmanifest
	header @static Cache-Control "public, max-age=86400, must-revalidate"

	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	@txt path /llms.txt /llms-full.txt /robots.txt
	header @txt Content-Type "text/plain; charset=utf-8"

	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}
